#!/bin/sh

set -eu

skills_root=${AGENT_SKILLS_ROOT:-"$HOME/.local/share/agent-skills"}

usage() {
  cat <<'EOF'
Usage:
  agent-skills bootstrap [SKILL [REPOSITORY_URL]]
  agent-skills doctor
  agent-skills update frontier-advisor
  agent-skills review robot-safety
  agent-skills update robot-safety COMMIT

Skills:
  frontier-advisor  https://github.com/alik-git/frontier-advisor-skill.git
EOF
}

repo_url() {
  case "$1" in
    frontier-advisor)
      printf '%s\n' 'https://github.com/alik-git/frontier-advisor-skill.git'
      ;;
    *)
      printf 'error: no public repository configured for %s; pass its repository URL\n' "$1" >&2
      return 1
      ;;
  esac
}

skill_dir() {
  printf '%s/%s\n' "$skills_root" "$1"
}

require_clone() {
  skill=$1
  dir=$(skill_dir "$skill")
  if ! git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
    printf 'error: %s is not cloned; run agent-skills bootstrap %s\n' "$skill" "$skill" >&2
    return 1
  fi
}

require_clean() {
  skill=$1
  dir=$(skill_dir "$skill")
  if [ -n "$(git -C "$dir" status --porcelain)" ]; then
    printf 'error: %s has local changes; refusing to update\n' "$skill" >&2
    return 1
  fi
}

bootstrap() {
  [ "$#" -gt 0 ] || set -- frontier-advisor
  if [ "$#" -eq 1 ]; then
    skill=$1
    url=$(repo_url "$skill")
  elif [ "$#" -eq 2 ]; then
    skill=$1
    url=$2
  else
    usage >&2
    return 2
  fi

  mkdir -p "$skills_root"
  dir=$(skill_dir "$skill")
  if git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
    printf '%s already exists at %s\n' "$skill" "$dir"
  elif [ -e "$dir" ]; then
    printf 'error: %s exists but is not a Git clone\n' "$dir" >&2
    return 1
  else
    git clone "$url" "$dir"
  fi
}

doctor() {
  failed=0
  for skill in frontier-advisor robot-safety; do
    dir=$(skill_dir "$skill")
    if git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
      revision=$(git -C "$dir" rev-parse --short HEAD)
      printf 'ok: %s at %s (%s)\n' "$skill" "$dir" "$revision"
    else
      printf 'missing: %s (%s)\n' "$skill" "$dir"
      failed=1
    fi

    for consumer in .agents .claude; do
      link="$HOME/$consumer/skills/$skill"
      if [ -L "$link" ] && [ "$(readlink "$link")" = "$dir" ]; then
        printf 'ok: %s -> %s\n' "$link" "$dir"
      else
        printf 'broken: %s should link to %s\n' "$link" "$dir"
        failed=1
      fi
    done
  done
  return "$failed"
}

update_frontier_advisor() {
  skill=frontier-advisor
  dir=$(skill_dir "$skill")
  require_clone "$skill"
  require_clean "$skill"
  branch=$(git -C "$dir" symbolic-ref --quiet --short HEAD || true)
  if [ "$branch" != main ]; then
    printf 'error: %s must be on main, not %s\n' "$skill" "${branch:-detached HEAD}" >&2
    return 1
  fi
  git -C "$dir" fetch origin main
  git -C "$dir" merge --ff-only origin/main
}

review_robot_safety() {
  skill=robot-safety
  dir=$(skill_dir "$skill")
  require_clone "$skill"
  git -C "$dir" fetch origin main
  candidate=$(git -C "$dir" rev-parse origin/main)
  printf 'current:   %s\n' "$(git -C "$dir" rev-parse HEAD)"
  printf 'candidate: %s\n' "$candidate"
  git -C "$dir" log --oneline --decorate HEAD.."$candidate"
  git -C "$dir" diff --stat HEAD "$candidate"
  printf '\nAfter review: agent-skills update robot-safety %s\n' "$candidate"
}

update_robot_safety() {
  skill=robot-safety
  commit=${1:-}
  if [ "${#commit}" -ne 40 ]; then
    printf 'error: robot-safety updates require the full reviewed 40-character commit SHA\n' >&2
    return 1
  fi
  case "$commit" in
    *[!0-9a-fA-F]*)
      printf 'error: robot-safety updates require the full reviewed 40-character commit SHA\n' >&2
      return 1
      ;;
    *) ;;
  esac

  dir=$(skill_dir "$skill")
  require_clone "$skill"
  require_clean "$skill"
  git -C "$dir" fetch origin
  git -C "$dir" cat-file -e "$commit^{commit}"
  git -C "$dir" -c advice.detachedHead=false checkout --detach "$commit"
}

command=${1:-}
[ "$#" -eq 0 ] || shift

case "$command" in
  bootstrap)
    bootstrap "$@"
    ;;
  doctor)
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    doctor
    ;;
  review)
    [ "$#" -eq 1 ] && [ "$1" = robot-safety ] || { usage >&2; exit 2; }
    review_robot_safety
    ;;
  update)
    skill=${1:-}
    [ "$#" -eq 0 ] || shift
    case "$skill" in
      frontier-advisor)
        [ "$#" -eq 0 ] || { usage >&2; exit 2; }
        update_frontier_advisor
        ;;
      robot-safety)
        [ "$#" -eq 1 ] || { usage >&2; exit 2; }
        update_robot_safety "$1"
        ;;
      *)
        usage >&2
        exit 2
        ;;
    esac
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
