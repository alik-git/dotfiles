#!/usr/bin/env python3
"""Remove the retired quick-status hook while preserving other user hooks."""

import json
import sys


def main():
    """Migrate existing hook settings; invalid JSON fails without replacement."""
    text = sys.stdin.read()
    config = json.loads(text) if text.strip() else {}
    events = config.get("hooks", {})
    entries = []
    for entry in events.get("PreToolUse", []):
        if entry.get("matcher") == "Bash":
            entry["hooks"] = [hook for hook in entry.get("hooks", [])
                              if hook.get("command") !=
                              "python3 ~/.codex/hooks/quick_status_pretool.py"]
            if not entry["hooks"]:
                continue
        entries.append(entry)
    if "PreToolUse" in events:
        if entries:
            events["PreToolUse"] = entries
        else:
            del events["PreToolUse"]
    print(json.dumps(config, indent=2))


if __name__ == "__main__":
    main()
