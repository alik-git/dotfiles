# ~/.profile: executed by the command interpreter for login shells.
# This file is not read by bash(1), if ~/.bash_profile or ~/.bash_login
# exists.
# see /usr/share/doc/bash/examples/startup-files for examples.
# the files are located in the bash-doc package.

# the default umask is set in /etc/profile; for setting the umask
# for ssh logins, install and configure the libpam-umask package.
#umask 022

# Keep pre-commit's hook cache in the writable Projects tree so sandboxed
# tools can run hooks without escalating for ~/.cache access.
export PRE_COMMIT_HOME="${PRE_COMMIT_HOME:-$HOME/Projects/.cache/pre-commit}"

if [ -d /opt/homebrew/bin ]; then
    PATH="/opt/homebrew/bin:$PATH"
fi

# if running bash
if [ -n "$BASH_VERSION" ]; then
    # include .bashrc if it exists
    if [ -f "$HOME/.bashrc" ]; then
        . "$HOME/.bashrc"
    fi
fi

# set PATH so it includes user's private bin if it exists
if [ -d "$HOME/bin" ] ; then
    PATH="$HOME/bin:$PATH"
fi

# set PATH so it includes user's private bin if it exists
if [ -d "$HOME/.local/bin" ] ; then
    PATH="$HOME/.local/bin:$PATH"
fi

# Task/secrets vars scripts need. Login shells (macOS via ~/.zprofile above;
# Linux directly, since there is no ~/.bash_profile so bash falls through to
# this file) do not read ~/.zshrc's/~/.bashrc's interactive-only chain, so
# load the same layer here too.
if [ -f "$HOME/.config/shell/env.sh" ]; then
    . "$HOME/.config/shell/env.sh"
fi

# Also reach non-interactive, non-login bash (e.g. `bash -c '...'`, how most
# scripts and agent/tool shells run): bash sources $BASH_ENV before running
# such a command, so point it at the same layer for any bash process that
# descends from a shell that read this file. Only set if nothing has already
# claimed BASH_ENV; zsh ignores this var entirely, so it is harmless there.
if [ -f "$HOME/.config/shell/env.sh" ] && [ -z "${BASH_ENV:-}" ]; then
    export BASH_ENV="$HOME/.config/shell/env.sh"
fi
