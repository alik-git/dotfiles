{{- /* Non-interactive env layer: the subset of the layered shell config that
       scripts, cron jobs, and non-interactive agent/tool shells need - the
       task-class env vars and this machine's decrypted secrets. It
       deliberately skips the machine layer (~/.config/shell/machine/local.sh):
       that file is free-form per-machine interactive shell UX, and on at
       least one machine it runs a side-effecting SSH-agent-socket refresh at
       source time - fine once per interactive shell, not something that
       should re-run on every non-interactive invocation.

       Sourced from every startup path that needs these vars without a live
       interactive shell: ~/.zshenv (every zsh invocation), ~/.profile (login
       shells on both OSes), ~/.bashrc's interactive tail (a plain new
       terminal on Linux is interactive but non-login, so it never reads
       ~/.profile), and via $BASH_ENV (non-interactive bash with no login
       ancestor - see ~/.profile). Every one of those shells must be able to
       parse this file, so keep it POSIX-sh: no zsh-only or bash-only syntax. */ -}}
{{ $taskType := index . "machine_class" | default "" -}}
_load_layer() { [ -f "$1" ] && . "$1"; }
{{- if $taskType }}
_load_layer "$HOME/.config/shell/task/{{ $taskType }}.sh"
{{- end }}
_load_layer "$HOME/.config/shell/machine/local.secrets.sh"
unset -f _load_layer
